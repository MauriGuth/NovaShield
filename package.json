{
  "name": "novashield",
  "version": "0.1.0",
  "private": true,
  "description": "Nova Shield — app móvil de ciberseguridad personal contra estafas, fraudes y hackeos (iOS & Android)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @novashield/shared",
    "prebackend": "npm run build:shared",
    "backend": "npm run start:dev --workspace apps/backend",
    "prebackend:build": "npm run build:shared",
    "backend:build": "npm run build --workspace apps/backend",
    "prebackend:test": "npm run build:shared",
    "backend:test": "npm run test --workspace apps/backend",
    "premobile": "npm run build:shared",
    "mobile": "npm run start --workspace apps/mobile",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspace apps/backend && npm run typecheck --workspace apps/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}

# URL del backend. En un build de desarrollo (dev client) el bundle lo sirve
# Metro desde tu máquina, así que alcanza con cambiar esto y recargar la app —
# no hace falta volver a compilar.
#
# Para probar en un teléfono FÍSICO no sirve localhost: poné la IP de tu
# computadora en la red WiFi (la ves con `ipconfig` en Windows o `ifconfig` en
# Mac/Linux) o una URL pública si ya desplegaste el backend.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Claves públicas de RevenueCat (las "public SDK keys", NO las secretas).
# Sin estas dos, la app corre entera en plan gratuito y no muestra paywall:
# es lo que querés durante el desarrollo.
# EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxx

# Desbloquea todas las funciones sin suscripción (builds de prueba del equipo).
# En desarrollo ya está desbloqueado por __DEV__; esto es para TestFlight.
# EXPO_PUBLIC_UNLOCK_ALL=1

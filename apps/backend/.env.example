# Puerto del servidor HTTP
PORT=3000

# Orígenes permitidos para CORS, separados por coma (default: todos, solo para dev)
# ALLOWED_ORIGINS=https://app.novashield.ar

# Capa 2 · Google Web Risk (uris:search). Sin clave, la capa queda apagada.
# Gratis hasta 100.000 consultas/mes. https://cloud.google.com/web-risk
# WEB_RISK_API_KEY=

# Capa 3b · Clasificación con Claude. Sin clave, la capa queda apagada.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5

# Capa 1 · URLhaus (abuse.ch) exige Auth-Key gratuita desde 2025.
# Registrarse en https://auth.abuse.ch — sin clave, la fuente se omite.
# URLHAUS_AUTH_KEY=
